{
  "containers": {
    "app": {
      "image": ":feedback-dashboard.latest.1",
      "ports": {
        "8501": "HTTP"
      },
      "environment": {
        "AWS_REGION": "us-east-1"
      }
    }
  },
  "publicEndpoint": {
    "containerName": "app",
    "containerPort": 8501,
    "healthCheck": {
      "healthyThreshold": 2,
      "unhealthyThreshold": 2,
      "timeoutSeconds": 5,
      "intervalSeconds": 10,
      "path": "/_stcore/health",
      "successCodes": "200-299"
    }
  }
} 